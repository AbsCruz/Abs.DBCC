<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Abs.DBCC.IntegrationTest</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Namensendung ".IntegrationTest" (nicht ".Test") ist bewusst gewählt: so kann der schnelle
         Unit-Test-Lauf per Glob (**/*.Test.csproj) dieses Projekt ausschließen, ohne Traits/Filter
         pflegen zu müssen. Dieses Projekt benötigt einen laufenden Docker-Daemon. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abs.DBCC.Infrastructure\Abs.DBCC.Infrastructure.csproj" />
    <ProjectReference Include="..\Abs.DBCC.TestCommon\Abs.DBCC.TestCommon.csproj" />
  </ItemGroup>

</Project>
