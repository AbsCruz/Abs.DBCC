<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Abs.DBCC.Desktop.ViewModels"
             xmlns:inspection="using:Abs.DBCC.Domain.Inspection"
             xmlns:res="using:Abs.DBCC.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Abs.DBCC.Desktop.Views.CollationOverviewView"
             x:DataType="vm:CollationOverviewViewModel">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.CollationOverviewTitle}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding DatabaseDefaultCollationDisplay}" />
            <TextBlock Text="{x:Static res:Strings.Loading}" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.BackButton}" Command="{Binding BackCommand}" />
            <Button Content="{x:Static res:Strings.ContinueToTargetCollationButton}" Command="{Binding ContinueCommand}" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inspection:TableCollationReport">
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding SchemaName}" /><Run Text="." /><Run Text="{Binding TableName}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Static res:Strings.MixedCollationLabel}" Foreground="OrangeRed" IsVisible="{Binding IsMixedCollation}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Columns}" Margin="16,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="inspection:ColumnCollationState">
                                            <TextBlock>
                                                <Run Text="{Binding ColumnName}" />
                                                <Run Text=" (" /><Run Text="{Binding SqlDataType}" /><Run Text=")" />
                                                <Run Text=" – " />
                                                <Run Text="{Binding Collation.Value}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
