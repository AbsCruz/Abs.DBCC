<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Abs.DBCC.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Abs.DBCC.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        Title="Abs.DBCC">

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="16,8"
                IsVisible="{Binding ConnectionDisplay, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ConnectionDisplay}" FontWeight="SemiBold" />
        </Border>

        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>

</Window>
