<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Abs.DBCC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="Abs.DBCC.Desktop.Views.ConnectionSetupView"
             x:DataType="vm:ConnectionSetupViewModel">

    <StackPanel Margin="24" Spacing="12" MaxWidth="420" HorizontalAlignment="Center">

        <TextBlock Text="Verbindung zur Datenbank" FontSize="20" FontWeight="Bold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Server" />
            <TextBox Text="{Binding Server}" PlaceholderText="z. B. localhost oder 192.168.1.10" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Datenbank" />
            <TextBox Text="{Binding Database}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Benutzer" />
            <TextBox Text="{Binding User}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Passwort" />
            <TextBox Text="{Binding Password}" PasswordChar="•" />
        </StackPanel>

        <CheckBox Content="Serverzertifikat vertrauen (TrustServerCertificate)"
                  IsChecked="{Binding TrustServerCertificate}" />

        <Button Content="Verbindung testen"
                Command="{Binding TestConnectionCommand}"
                IsEnabled="{Binding !IsTesting}" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />

        <Button Content="Weiter"
                Command="{Binding ContinueCommand}"
                HorizontalAlignment="Right" />

    </StackPanel>

</UserControl>
