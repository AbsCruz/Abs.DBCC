<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Abs.DBCC.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="Abs.DBCC.Desktop.Views.MigrationPlanReviewView"
             x:DataType="vm:MigrationPlanReviewViewModel">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Migrationsplan prüfen" FontSize="20" FontWeight="Bold" />
            <TextBlock>
                <Run Text="Von " /><Run Text="{Binding Plan.SourceCollation.Value}" FontWeight="Bold" />
                <Run Text=" nach " /><Run Text="{Binding Plan.TargetCollation.Value}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Text="{Binding Plan.AffectedTables.Count, StringFormat='Betroffene Tabellen: {0}'}" />

            <TextBlock Text="Prüfe aktive Sitzungen und Datenmenge..." IsVisible="{Binding IsLoadingPreflight}" />
            <StackPanel Spacing="4" IsVisible="{Binding Preflight, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Preflight.OtherActiveSessionCount, StringFormat='Andere aktive Verbindungen zur Datenbank: {0}'}" Foreground="OrangeRed" />
                <TextBlock Text="{Binding Preflight.EstimatedAffectedRowCount, StringFormat='Geschätzte Zeilen in betroffenen Tabellen: {0}'}" />
                <TextBlock Text="{Binding LogFileSizeDisplay, StringFormat='Transaktionsprotokoll aktuell: {0}'}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Zurück" Command="{Binding BackCommand}" />
            <Button Content="Migration starten" Command="{Binding StartCommand}" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding StepCounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepKindCount">
                        <TextBlock>
                            <Run Text="{Binding Count}" FontWeight="Bold" />
                            <Run Text="×" />
                            <Run Text="{Binding Kind}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
