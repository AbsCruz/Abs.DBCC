<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Abs.DBCC.Desktop.ViewModels"
             xmlns:res="using:Abs.DBCC.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="Abs.DBCC.Desktop.Views.MigrationPlanReviewView"
             x:DataType="vm:MigrationPlanReviewViewModel">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.ReviewMigrationPlanTitle}" FontSize="20" FontWeight="Bold" />
            <TextBlock>
                <Run Text="{x:Static res:Strings.FromLabel}" /><Run Text="{Binding Plan.SourceCollation.Value}" FontWeight="Bold" />
                <Run Text="{x:Static res:Strings.ToLabel}" /><Run Text="{Binding Plan.TargetCollation.Value}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Text="{Binding AffectedTablesDisplay}" />

            <TextBlock Text="{x:Static res:Strings.CheckingActiveSessions}" IsVisible="{Binding IsLoadingPreflight}" />
            <StackPanel Spacing="4" IsVisible="{Binding Preflight, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasOtherActiveConnections}">
                    <TextBlock Text="{Binding OtherActiveConnectionsDisplay}" Foreground="OrangeRed" VerticalAlignment="Center" />
                    <Button Content="{x:Static res:Strings.RecheckActiveConnectionsButton}" Command="{Binding LoadPreflightCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding EstimatedAffectedRowsDisplay}" />
                <TextBlock Text="{Binding TransactionLogDisplay}" />
                <StackPanel Spacing="4" IsVisible="{Binding !SkipDataVerification}">
                    <TextBlock Text="{Binding EstimatedVerificationMemoryDisplay}" />
                    <TextBlock Text="{Binding AvailableMemoryDisplay}" />
                    <TextBlock Text="{x:Static res:Strings.MemoryEstimateExceedsAvailableWarning}" Foreground="OrangeRed" FontWeight="SemiBold"
                               IsVisible="{Binding EstimatedMemoryExceedsAvailable}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />

            <StackPanel Spacing="2" Margin="0,8,0,0">
                <TextBlock Text="{x:Static res:Strings.ProcessOverviewTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.ProcessOverviewStep1}" IsVisible="{Binding !SkipDataVerification}" />
                <TextBlock Text="{Binding ProcessOverviewStep2}" />
                <TextBlock Text="{x:Static res:Strings.ProcessOverviewStep3}" />
                <TextBlock Text="{x:Static res:Strings.ProcessOverviewStep4}" IsVisible="{Binding !SkipDataVerification}" />
                <TextBlock Text="{x:Static res:Strings.ProcessOverviewStep5}" IsVisible="{Binding !SkipDataVerification}" />
            </StackPanel>

            <CheckBox Content="{x:Static res:Strings.SkipDataVerificationLabel}" IsChecked="{Binding SkipDataVerification}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.BackButton}" Command="{Binding BackCommand}" />
            <Button Content="{x:Static res:Strings.ExportScriptButton}" Command="{Binding ExportScriptCommand}" />
            <Button Content="{x:Static res:Strings.StartMigrationButton}" Command="{Binding StartCommand}" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding StepCounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepKindCount">
                        <TextBlock>
                            <Run Text="{Binding Count}" FontWeight="Bold" />
                            <Run Text="×" />
                            <Run Text="{Binding Kind}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
