<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Abs.DBCC.Desktop.ViewModels"
             xmlns:migration="using:Abs.DBCC.Domain.Migration"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="Abs.DBCC.Desktop.Views.MigrationResultView"
             x:DataType="vm:MigrationResultViewModel">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Migration erfolgreich"
                       FontSize="20" FontWeight="Bold" Foreground="Green"
                       IsVisible="{Binding Report.Succeeded}" />
            <TextBlock Text="Migration fehlgeschlagen"
                       FontSize="20" FontWeight="Bold" Foreground="Red"
                       IsVisible="{Binding !Report.Succeeded}" />
            <TextBlock Text="{Binding Report.FailureReason}" Foreground="Red" />

            <TextBlock Text="Strukturprüfung erfolgreich - keine Abweichungen."
                       Foreground="Green"
                       IsVisible="{Binding Report.Verification.IsSuccess}" />
            <TextBlock Text="Es wurden Abweichungen bei der Struktur- oder Datenprüfung gefunden:"
                       Foreground="OrangeRed"
                       IsVisible="{Binding !Report.Verification.IsSuccess}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Bericht exportieren" Command="{Binding ExportReportCommand}" />
            <Button Content="Neue Migration starten" Command="{Binding RestartCommand}" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="12">

                <ItemsControl ItemsSource="{Binding Report.Verification.StructuralDiffs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="migration:StructuralDiff">
                            <TextBlock Foreground="OrangeRed">
                                <Run Text="{Binding ObjectDescription}" FontWeight="Bold" /><Run Text=": " /><Run Text="{Binding Details}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Report.Verification.DataDiffs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="migration:DataDiff">
                            <TextBlock Foreground="OrangeRed">
                                <Run Text="{Binding TableDescription}" FontWeight="Bold" /><Run Text=": " /><Run Text="{Binding Details}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Schritt-Log" FontWeight="Bold" />
                <ItemsControl ItemsSource="{Binding Report.StepResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="migration:MigrationStepResult">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✓" Foreground="Green" IsVisible="{Binding Succeeded}" />
                                <TextBlock Text="✗" Foreground="Red" IsVisible="{Binding !Succeeded}" />
                                <TextBlock Text="{Binding Step.Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
